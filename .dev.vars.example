# OAuth application configured in Google Cloud → Google Auth Platform.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The URL must exactly match the Authorized redirect URI in Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=https://seo.example.com/api/auth/google/callback
# 32 random bytes, base64 encoded. Needed for AES-GCM refresh-token encryption.
TOKEN_ENCRYPTION_KEY=
# The first (or several) permanent administrator emails. Separate with commas.
ADMIN_EMAILS=admin@example.com
# Secret for scheduled /api/sync.
CRON_SECRET=
# Optional fallback ONLY for legacy service-account imports.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
APP_ENV=production
