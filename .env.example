# Required: create a restricted D1 API token in Cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Google Search Console property, exact spelling as in Search Console.
# Example URL-prefix property: https://example.com/
# Example Domain property: sc-domain:example.com
GSC_SITE_URL=https://example.com/

# Google service-account JSON stored as one-line environment secret.
# Grant the service-account email Read access to the GSC property.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Required HTTP Basic Auth for ALL dashboard pages and data APIs.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Secret for scheduled GET /api/sync requests.
CRON_SECRET=

# Must match GSC_SITE_URL for URL-prefix properties; visible in browser only.
NEXT_PUBLIC_SITE_URL=https://example.com
